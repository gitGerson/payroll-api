# SQLite database file (optional, defaults to ./data/payroll.db, or /tmp/payroll.db on Vercel)
DB_PATH=./data/payroll.db

# Basic Auth credentials for the API
# The Authorization header value is: Basic base64(API_USERNAME:API_PASSWORD)
API_USERNAME=your_api_username
API_PASSWORD=your_api_password

# Server port (optional, defaults to 3000)
PORT=3000
